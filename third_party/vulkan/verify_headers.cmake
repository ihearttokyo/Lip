# Read-only integrity check for Lip's pinned, build-only Vulkan header selection.
# This checks the reviewed source manifest, not authenticity of arbitrary pairs.
function(lip_verify_vulkan_headers root)
    if(IS_SYMLINK "${root}" OR IS_SYMLINK "${root}/source.json" OR NOT EXISTS "${root}/source.json")
        message(FATAL_ERROR "LIP_VULKAN_PIN_MANIFEST_REQUIRED")
    endif()
    file(READ "${root}/source.json" _manifest)
    string(JSON _schema GET "${_manifest}" schema)
    string(JSON _commit GET "${_manifest}" upstream commit)
    string(JSON _version GET "${_manifest}" header_version)
    if(NOT _schema EQUAL 1 OR NOT _version EQUAL 335 OR
            NOT _commit STREQUAL "2fa203425eb4af9dfc6b03f97ef72b0b5bcb8350")
        message(FATAL_ERROR "LIP_VULKAN_UNREVIEWED_SOURCE_PIN")
    endif()
    string(JSON _count LENGTH "${_manifest}" files)
    if(NOT _count EQUAL 52)
        message(FATAL_ERROR "LIP_VULKAN_PIN_FILE_COUNT_CHANGED")
    endif()
    math(EXPR _last "${_count} - 1")
    set(_expected "")
    foreach(_index RANGE 0 ${_last})
        string(JSON _name MEMBER "${_manifest}" files ${_index})
        if(IS_ABSOLUTE "${_name}" OR _name MATCHES "(^|/)\\.\\.(/|$)|\\\\|;" OR
                NOT _name MATCHES "^(include/|LICENSES/|LICENSE\\.md$)")
            message(FATAL_ERROR "LIP_VULKAN_NONCANONICAL_PIN_MEMBER")
        endif()
        string(REPLACE "/" ";" _parts "${_name}")
        set(_member "${root}")
        foreach(_part IN LISTS _parts)
            set(_member "${_member}/${_part}")
            if(IS_SYMLINK "${_member}")
                message(FATAL_ERROR "LIP_VULKAN_PIN_SYMLINK:${_name}")
            endif()
        endforeach()
        if(NOT EXISTS "${_member}" OR IS_DIRECTORY "${_member}")
            message(FATAL_ERROR "LIP_VULKAN_PIN_MEMBER_MISSING:${_name}")
        endif()
        string(JSON _bytes GET "${_manifest}" files "${_name}" bytes)
        string(JSON _sha GET "${_manifest}" files "${_name}" sha256)
        file(SIZE "${_member}" _actual_bytes)
        if(_bytes LESS 1 OR NOT _actual_bytes EQUAL _bytes)
            message(FATAL_ERROR "LIP_VULKAN_PIN_SIZE_MISMATCH:${_name}")
        endif()
        file(SHA256 "${_member}" _actual_sha)
        if(NOT _actual_sha STREQUAL _sha)
            message(FATAL_ERROR "LIP_VULKAN_PIN_HASH_MISMATCH:${_name}")
        endif()
        list(APPEND _expected "${_name}")
    endforeach()
    file(GLOB_RECURSE _actual RELATIVE "${root}" LIST_DIRECTORIES FALSE
         "${root}/include/*" "${root}/LICENSES/*")
    list(APPEND _actual LICENSE.md)
    list(SORT _actual)
    list(SORT _expected)
    if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "LIP_VULKAN_PIN_HEADER_SET_MISMATCH")
    endif()
    message(STATUS "Lip Vulkan-Headers335: all52 pinned upstream files verified")
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    if(NOT DEFINED LIP_VULKAN_HEADER_ROOT)
        message(FATAL_ERROR "LIP_VULKAN_HEADER_ROOT_REQUIRED")
    endif()
    lip_verify_vulkan_headers("${LIP_VULKAN_HEADER_ROOT}")
endif()
