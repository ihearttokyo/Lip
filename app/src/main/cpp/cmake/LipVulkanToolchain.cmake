# Preparatory only: this file is not included by Lip's production CMakeLists.txt.
# Run after project(... CXX) under the real Android NDK toolchain. It neither
# enables GGML_VULKAN nor selects an inference device. No dependency downloads.
include_guard(GLOBAL)

function(lip_prepare_android_vulkan)
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Android" OR NOT CMAKE_CROSSCOMPILING
            OR NOT CMAKE_CXX_COMPILER_LOADED)
        message(FATAL_ERROR "LIP_VULKAN_ANDROID_TOOLCHAIN_REQUIRED")
    endif()
    # FindVulkan and header-only package configs may reuse existing imported
    # targets without replacing their properties. Refuse them before probing so
    # a later package consumer cannot silently bind a foreign loader/header/tool.
    foreach(_existing_target Vulkan::Vulkan Vulkan::Headers Vulkan::glslc SPIRV-Headers::SPIRV-Headers)
        if(TARGET "${_existing_target}")
            message(FATAL_ERROR "LIP_VULKAN_PREEXISTING_TARGET:${_existing_target}")
        endif()
    endforeach()
    # The NDK's legacy toolchain deliberately sets CMAKE_SYSTEM_VERSION=1;
    # ANDROID_PLATFORM_LEVEL is its resolved (including alias-adjusted) API.
    if(DEFINED ANDROID_PLATFORM_LEVEL)
        set(_api "${ANDROID_PLATFORM_LEVEL}")
        if(NOT CMAKE_SYSTEM_VERSION STREQUAL "1" AND NOT CMAKE_SYSTEM_VERSION STREQUAL _api)
            message(FATAL_ERROR "LIP_VULKAN_API_TOOLCHAIN_MISMATCH")
        endif()
    else()
        set(_api "${CMAKE_SYSTEM_VERSION}")
    endif()
    if(NOT _api MATCHES "^[0-9]+$" OR _api LESS 24)
        message(FATAL_ERROR "LIP_VULKAN_API_24_OR_LATER_REQUIRED")
    endif()
    if(CMAKE_ANDROID_ARCH_ABI STREQUAL "arm64-v8a")
        set(_triple aarch64-linux-android)
        set(_machine b700)
    elseif(CMAKE_ANDROID_ARCH_ABI STREQUAL "x86_64")
        set(_triple x86_64-linux-android)
        set(_machine 3e00)
    else()
        message(FATAL_ERROR "LIP_VULKAN_UNSUPPORTED_ABI:${CMAKE_ANDROID_ARCH_ABI}")
    endif()
    file(REAL_PATH "${CMAKE_ANDROID_NDK}" _ndk)
    if(NOT EXISTS "${_ndk}/source.properties" OR NOT EXISTS "${_ndk}/build/cmake/android.toolchain.cmake")
        message(FATAL_ERROR "LIP_VULKAN_NDK_REQUIRED")
    endif()
    file(REAL_PATH "${CMAKE_SYSROOT}" _sysroot)
    get_filename_component(_prebuilt "${_sysroot}" DIRECTORY)
    get_filename_component(_host "${_prebuilt}" NAME)
    if(NOT _prebuilt STREQUAL "${_ndk}/toolchains/llvm/prebuilt/${_host}")
        message(FATAL_ERROR "LIP_VULKAN_SYSROOT_NDK_MISMATCH")
    endif()
    file(REAL_PATH "${CMAKE_CXX_COMPILER}" _compiler)
    string(FIND "${_compiler}" "${_prebuilt}/bin/" _compiler_prefix)
    if(NOT _compiler_prefix EQUAL 0)
        message(FATAL_ERROR "LIP_VULKAN_COMPILER_NDK_MISMATCH")
    endif()
    set(_loader "${_sysroot}/usr/lib/${_triple}/${_api}/libvulkan.so")
    if(NOT EXISTS "${_loader}")
        message(FATAL_ERROR "LIP_VULKAN_EXACT_ABI_API_LOADER_MISSING:${_loader}")
    endif()
    file(READ "${_loader}" _elf LIMIT 20 HEX)
    # ELF64, little endian, the requested ABI; never link a host Vulkan loader.
    if(NOT _elf MATCHES "^7f454c460201" OR NOT _elf MATCHES "${_machine}$")
        message(FATAL_ERROR "LIP_VULKAN_LOADER_ABI_MISMATCH")
    endif()
    set(_glslc "${_ndk}/shader-tools/${_host}/glslc${CMAKE_HOST_EXECUTABLE_SUFFIX}")
    if(NOT EXISTS "${_glslc}")
        message(FATAL_ERROR "LIP_VULKAN_HOST_GLSLC_MISSING:${_glslc}")
    endif()
    execute_process(COMMAND "${_glslc}" --version RESULT_VARIABLE _glslc_status
        OUTPUT_VARIABLE _glslc_version ERROR_VARIABLE _glslc_error TIMEOUT 15)
    if(NOT "${_glslc_status}" STREQUAL "0" OR NOT _glslc_version MATCHES "shaderc")
        message(FATAL_ERROR "LIP_VULKAN_HOST_GLSLC_UNUSABLE:${_glslc_status}:${_glslc_error}")
    endif()
    set(_spirv "${_ndk}/sources/third_party/shaderc/third_party/spirv-tools/external/spirv-headers/include")
    foreach(_header spirv/unified1/spirv.hpp spirv/unified1/spirv.h)
        if(NOT EXISTS "${_spirv}/${_header}")
            message(FATAL_ERROR "LIP_VULKAN_SPIRV_HEADER_MISSING:${_header}")
        endif()
    endforeach()
    # The NDK may ship only Vulkan C headers. Never claim that satisfies Vulkan-Hpp.
    # An explicit local replacement must contain BOTH matching C and C++ headers;
    # a compiler probe below checks their transitive closure and version assertion.
    if(DEFINED LIP_VULKAN_HEADERS_INCLUDE_DIR)
        file(REAL_PATH "${LIP_VULKAN_HEADERS_INCLUDE_DIR}" _headers)
    else()
        set(_headers "${_sysroot}/usr/include")
    endif()
    foreach(_header vulkan/vulkan.h vulkan/vulkan_core.h vulkan/vulkan.hpp)
        if(NOT EXISTS "${_headers}/${_header}")
            message(FATAL_ERROR "LIP_VULKAN_COHERENT_CPP_HEADERS_MISSING:${_headers}/${_header}")
        endif()
    endforeach()
    set(_work "${CMAKE_CURRENT_BINARY_DIR}/lip-vulkan-toolchain")
    file(MAKE_DIRECTORY "${_work}")
    file(WRITE "${_work}/headers.cpp" "#include <vulkan/vulkan.hpp>\n#include <spirv/unified1/spirv.hpp>\nint main() { vk::ApplicationInfo info{}; return int(info.apiVersion) + int(spv::OpNop); }\n")
    try_compile(_headers_compile "${_work}/headers-build" "${_work}/headers.cpp"
        CMAKE_FLAGS "-DCMAKE_CXX_STANDARD=17" "-DINCLUDE_DIRECTORIES=${_headers};${_spirv}"
        OUTPUT_VARIABLE _headers_log)
    file(WRITE "${_work}/headers-probe.log" "${_headers_log}")
    if(NOT _headers_compile)
        message(FATAL_ERROR "LIP_VULKAN_COHERENT_CPP_HEADERS_COMPILE_FAILED:${_work}/headers-probe.log")
    endif()
    file(WRITE "${_work}/probe.comp" "#version 450\nlayout(local_size_x=1) in;\nvoid main() {}\n")
    execute_process(COMMAND "${_glslc}" --target-env=vulkan1.3 -fshader-stage=compute
        "${_work}/probe.comp" -o "${_work}/probe.spv"
        RESULT_VARIABLE _shader_status OUTPUT_VARIABLE _shader_out ERROR_VARIABLE _shader_error TIMEOUT 30)
    if(NOT "${_shader_status}" STREQUAL "0" OR NOT EXISTS "${_work}/probe.spv")
        message(FATAL_ERROR "LIP_VULKAN_SHADER_PROBE_FAILED:${_shader_status}:${_shader_error}")
    endif()
    file(READ "${_work}/probe.spv" _magic LIMIT 4 HEX)
    if(NOT _magic STREQUAL "03022307")
        message(FATAL_ERROR "LIP_VULKAN_SHADER_PROBE_NOT_SPIRV")
    endif()
    # A real header-only package adapter, not a fake FOUND flag. It defines the
    # conventional target from the actual NDK headers; no version is fabricated.
    # The consumer must link this target to ggml-vulkan: upstream only finds the
    # package and does not itself propagate the target's include directory.
    set(_config_dir "${_work}/SPIRV-Headers")
    file(MAKE_DIRECTORY "${_config_dir}")
    file(WRITE "${_config_dir}/SPIRV-HeadersConfig.cmake"
        "if(NOT TARGET SPIRV-Headers::SPIRV-Headers)\n  add_library(SPIRV-Headers::SPIRV-Headers INTERFACE IMPORTED)\n  set_target_properties(SPIRV-Headers::SPIRV-Headers PROPERTIES INTERFACE_INCLUDE_DIRECTORIES [==[${_spirv}]==])\nendif()\n")
    set(Vulkan_INCLUDE_DIR "${_headers}" PARENT_SCOPE)
    set(Vulkan_LIBRARY "${_loader}" PARENT_SCOPE)
    set(Vulkan_GLSLC_EXECUTABLE "${_glslc}" PARENT_SCOPE)
    set(SPIRV-Headers_DIR "${_config_dir}" PARENT_SCOPE)
    set(LIP_VULKAN_TOOLCHAIN_SPIRV_INCLUDE "${_spirv}" PARENT_SCOPE)
    set(LIP_VULKAN_TOOLCHAIN_PROBE_DIR "${_work}" PARENT_SCOPE)
    message(STATUS "Lip Vulkan toolchain dependencies probed; backend/device NOT enabled")
endfunction()
