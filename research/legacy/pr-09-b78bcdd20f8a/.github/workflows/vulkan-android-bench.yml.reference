name: Isolated Android CPU Vulkan benchmark package (no execution)
on:
  push:
    branches: [codex/lip-vulkan-android]
permissions:
  contents: read
concurrency:
  group: lip-vulkan-android-bench
  cancel-in-progress: false
jobs:
  build:
    if: >-
      github.repository == 'ihearttokyo/Lip' && github.event.repository.private == false &&
      github.repository_owner == 'ihearttokyo' && github.ref == 'refs/heads/codex/lip-vulkan-android' &&
      github.workflow_ref == 'ihearttokyo/Lip/.github/workflows/vulkan-android-bench.yml@refs/heads/codex/lip-vulkan-android' &&
      github.event_name == 'push' && contains(github.event.head_commit.message, '[vulkan-android-bench]')
    runs-on: ubuntu-24.04
    timeout-minutes: 50
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          submodules: recursive
          persist-credentials: false
      - name: Admit exact opt-in checked-out push and pinned pristine source
        id: admit
        env:
          VULKAN_RUNNER_TEMP: ${{ runner.temp }}
        run: python3 -B eval/vulkan_android_ci.py admit
      - name: Install qualified NDK and CMake within bounded allocator
        timeout-minutes: 21
        env:
          VULKAN_RUNNER_TEMP: ${{ runner.temp }}
          VULKAN_EVIDENCE: ${{ steps.admit.outputs.evidence }}
          VULKAN_SCRATCH: ${{ steps.admit.outputs.scratch }}
        run: python3 -B eval/vulkan_android_ci.py install
      - name: Build same-binary CPU Vulkan CLI and verify package closure
        id: build
        timeout-minutes: 46
        env:
          VULKAN_RUNNER_TEMP: ${{ runner.temp }}
          VULKAN_EVIDENCE: ${{ steps.admit.outputs.evidence }}
          VULKAN_SCRATCH: ${{ steps.admit.outputs.scratch }}
        run: python3 -B eval/vulkan_android_ci.py build
      - name: Retain bounded text evidence including failures
        if: always() && steps.admit.outcome == 'success'
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: Lip-vulkan-android-evidence-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}
          path: |
            ${{ steps.admit.outputs.evidence }}/*.json
            ${{ steps.admit.outputs.evidence }}/*.txt
          if-no-files-found: error
          retention-days: 7
      - name: Publish isolated benchmark binary package only after all build gates
        if: success() && steps.build.outcome == 'success'
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: Lip-vulkan-android-bench-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ steps.admit.outputs.package }}
          if-no-files-found: error
          retention-days: 7
